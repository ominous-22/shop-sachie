---
import { getCollection, getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const settingsEntry = await getEntry('settings', 'site');
const contactEmail = settingsEntry?.data.contactEmail ?? 'hello@example.com';

const rawPieces = await getCollection('pieces');
const sortedPieces = rawPieces.sort((a, b) => {
  if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
  return b.data.date.getTime() - a.data.date.getTime();
});

const pieces = await Promise.all(
  sortedPieces.map(async (piece) => {
    const { Content } = await render(piece);
    const room =
      piece.data.status === 'WIP'
        ? 'workbench'
        : piece.data.status === 'Sold'
          ? 'archive'
          : 'showroom';
    return { ...piece, Content, room };
  })
);
---

<BaseLayout>
  <main class="container">
    <div class="controls">
      <div class="room-tabs" role="tablist">
        <button class="tab active" data-room="all">Everything ({pieces.length})</button>
        <button class="tab" data-room="showroom">The Showroom</button>
        <button class="tab" data-room="archive">Oddities & Archive</button>
        <button class="tab" data-room="workbench">The Workbench (WIP)</button>
      </div>

      <div class="category-pills">
        <button class="pill active" data-cat="all">All Mediums</button>
        <button class="pill" data-cat="Furniture">Furniture</button>
        <button class="pill" data-cat="Sculpture">Sculpture</button>
        <button class="pill" data-cat="Dolls">Dolls</button>
        <button class="pill" data-cat="Paintings">Paintings</button>
        <button class="pill" data-cat="Oddities">Oddities</button>
      </div>
    </div>

    {pieces.length === 0 ? (
      <div class="empty-state">
        <h2>The studio shelves are ready.</h2>
        <p>
          Log into Pages CMS to post your first sculpture, doll, painting, or furniture flip—or check out the{' '}
          <a href={`${base}/guide`}>Owner's Manual</a>.
        </p>
      </div>
    ) : (
      <div class="grid" id="piece-grid">
        {pieces.map((item) => {
          const mailSubject = encodeURIComponent(`Inquiry: ${item.data.title}`);
          const mailBody = encodeURIComponent(
            `Hey Sachie! I saw "${item.data.title}" on Shop Sachie and wanted to ask about it.`
          );

          return (
            <article class="card" data-room={item.room} data-category={item.data.category}>
              <div class="image-wrap">
                <span class={`badge status-${item.data.status.toLowerCase().replace(/\s+/g, '-')}`}>
                  {item.data.status}
                </span>
                <span class="cat-tag">{item.data.category}</span>
                <Image
                  src={item.data.coverImage}
                  alt={item.data.title}
                  width={700}
                  height={700}
                  class="card-img"
                />
              </div>

              <div class="card-body">
                <div class="card-top">
                  <h2>{item.data.title}</h2>
                  {item.data.price && item.data.status !== 'Sold' && (
                    <span class="price">{item.data.price}</span>
                  )}
                </div>

                {(item.data.dimensions || item.data.materials) && (
                  <ul class="specs">
                    {item.data.dimensions && <li><strong>Size:</strong> {item.data.dimensions}</li>}
                    {item.data.materials && <li><strong>Materials:</strong> {item.data.materials}</li>}
                  </ul>
                )}

                <div class="notes">
                  <item.Content />
                </div>

                {item.data.gallery && item.data.gallery.length > 0 && (
                  <details class="extra-photos">
                    <summary>View {item.data.gallery.length} more photo(s)</summary>
                    <div class="mini-grid">
                      {item.data.gallery.map((img) => (
                        <Image src={img} alt={item.data.title} width={400} class="mini-img" />
                      ))}
                    </div>
                  </details>
                )}

                <div class="card-actions">
                  {item.data.status === 'Available' && item.data.paymentLink && (
                    <a href={item.data.paymentLink} target="_blank" rel="noreferrer" class="btn btn-primary">
                      Claim / Buy Now →
                    </a>
                  )}
                  {(item.data.status === 'Available' || item.data.status === 'Commission Only') && (
                    <a
                      href={`mailto:${contactEmail}?subject=${mailSubject}&body=${mailBody}`}
                      class="btn btn-secondary"
                    >
                      {item.data.status === 'Commission Only' ? 'Request Commission' : 'Inquire / Hold'}
                    </a>
                  )}
                </div>
              </div>
            </article>
          );
        })}
      </div>
    )}
  </main>
</BaseLayout>

<script>
  let activeRoom = 'all';
  let activeCat = 'all';
  const cards = document.querySelectorAll<HTMLElement>('.card');
  const roomBtns = document.querySelectorAll<HTMLButtonElement>('.tab');
  const catBtns = document.querySelectorAll<HTMLButtonElement>('.pill');

  function applyFilters() {
    cards.forEach((card) => {
      const matchRoom = activeRoom === 'all' || card.dataset.room === activeRoom;
      const matchCat = activeCat === 'all' || card.dataset.category === activeCat;
      card.style.display = matchRoom && matchCat ? 'flex' : 'none';
    });
  }

  roomBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      roomBtns.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      activeRoom = btn.dataset.room ?? 'all';
      applyFilters();
    });
  });

  catBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      catBtns.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      activeCat = btn.dataset.cat ?? 'all';
      applyFilters();
    });
  });
</script>

<style>
  .container { max-width: 1200px; margin: 0 auto; padding: 2rem 1.5rem; }
  .controls { display: flex; flex-direction: column; gap: 1rem; margin-bottom: 2.25rem; }
  .room-tabs, .category-pills { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .tab {
    background: transparent;
    color: var(--ink);
    border: 2px solid var(--border);
    padding: 0.6rem 1.1rem;
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700;
    font-size: 0.95rem;
    cursor: pointer;
  }
  .tab.active { background: var(--ink); color: var(--bg); }
  .pill {
    background: transparent;
    color: var(--ink);
    border: 1px dashed var(--border);
    padding: 0.35rem 0.8rem;
    font-family: 'Space Mono', monospace;
    font-size: 0.8rem;
    cursor: pointer;
  }
  .pill.active { background: var(--accent); color: #fff; border-style: solid; border-color: var(--accent); }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(330px, 1fr)); gap: 2rem; }
  .card {
    display: flex;
    flex-direction: column;
    background: var(--card-bg);
    border: 2px solid var(--border);
    box-shadow: 6px 6px 0 var(--border);
    transition: transform 0.15s ease;
  }
  .card:hover { transform: translate(-2px, -2px); }
  .image-wrap {
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-bottom: 2px solid var(--border);
    background: #eae6df;
  }
  .card-img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .badge {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    padding: 0.25rem 0.65rem;
    font-family: 'Space Mono', monospace;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    border: 2px solid #181818;
    background: #fff;
    color: #181818;
  }
  .status-available { background: var(--accent); color: #fff; }
  .status-sold { background: #181818; color: #fff; }
  .status-wip { background: #ffd166; color: #181818; }
  .cat-tag {
    position: absolute;
    bottom: 0.75rem;
    right: 0.75rem;
    background: rgba(24, 24, 24, 0.85);
    color: #fff;
    padding: 0.2rem 0.55rem;
    font-family: 'Space Mono', monospace;
    font-size: 0.72rem;
  }
  .card-body { padding: 1.25rem; display: flex; flex-direction: column; flex: 1; gap: 0.85rem; }
  .card-top { display: flex; justify-content: space-between; align-items: flex-start; gap: 0.75rem; }
  .card-top h2 { margin: 0; font-size: 1.35rem; line-height: 1.2; }
  .price { font-family: 'Space Mono', monospace; font-weight: 700; font-size: 1.1rem; color: var(--accent); white-space: nowrap; }
  .specs {
    list-style: none;
    padding: 0.6rem 0.75rem;
    margin: 0;
    background: rgba(128, 128, 128, 0.08);
    font-family: 'Space Mono', monospace;
    font-size: 0.78rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .notes { font-size: 0.95rem; line-height: 1.55; opacity: 0.9; }
  .notes :global(p:first-child) { margin-top: 0; }
  .extra-photos summary { font-family: 'Space Mono', monospace; font-size: 0.8rem; cursor: pointer; text-decoration: underline; }
  .mini-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.5rem; margin-top: 0.65rem; }
  .mini-img { width: 100%; height: auto; border: 1px solid var(--border); }
  .card-actions { margin-top: auto; padding-top: 0.75rem; display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .btn {
    display: inline-block;
    padding: 0.55rem 0.95rem;
    font-family: 'Space Mono', monospace;
    font-size: 0.82rem;
    font-weight: 700;
    text-decoration: none;
    border: 2px solid var(--border);
    cursor: pointer;
  }
  .btn-primary { background: var(--accent); color: #fff; }
  .btn-secondary { background: transparent; color: var(--ink); }
  .empty-state { border: 2px dashed var(--border); padding: 3rem 1.5rem; text-align: center; }
</style>
