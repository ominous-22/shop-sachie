---
import { getCollection, getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';

const settingsEntry = await getEntry('settings', 'site');
const contactEmail = settingsEntry?.data.contactEmail ?? 'hello@example.com';

const rawPieces = await getCollection('pieces');
const sortedPieces = rawPieces.sort((a, b) => {
  if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
  return b.data.date.getTime() - a.data.date.getTime();
});

const pieces = await Promise.all(
  sortedPieces.map(async (piece, idx) => {
    const { Content } = await render(piece);
    const room =
      piece.data.status === 'WIP'
        ? 'workbench'
        : piece.data.status === 'Sold'
          ? 'archive'
          : 'showroom';
    const tilts = ['-1deg', '0.8deg', '-0.5deg', '1.1deg'];
    const tilt = tilts[idx % tilts.length];
    return { ...piece, Content, room, tilt };
  })
);
---

<BaseLayout>
  <main class="container">
    <div class="controls">
      <div class="room-tabs" role="tablist">
        <button class="tab active" data-room="all">◆ All Rooms ({pieces.length})</button>
        <button class="tab" data-room="showroom">▲ The Showroom</button>
        <button class="tab" data-room="archive">■ Oddities & Archive</button>
        <button class="tab" data-room="workbench">● The Workbench (WIP)</button>
      </div>

      <div class="category-pills">
        <button class="pill active" data-cat="all">Everything</button>
        <button class="pill" data-cat="Furniture">Furniture</button>
        <button class="pill" data-cat="Sculpture">Sculpture</button>
        <button class="pill" data-cat="Dolls">Dolls</button>
        <button class="pill" data-cat="Paintings">Paintings</button>
        <button class="pill" data-cat="Oddities">Oddities</button>
      </div>
    </div>

    <div class="masonry-wall" id="piece-grid">
      {pieces.map((item) => {
        const mailSubject = encodeURIComponent(`Inquiry: ${item.data.title}`);
        const mailBody = encodeURIComponent(
          `Hey Sachie! I saw "${item.data.title}" on Shop Sachie and wanted to ask about it.`
        );

        return (
          <article
            class="card"
            data-room={item.room}
            data-category={item.data.category}
            style={`--tilt: ${item.tilt};`}
          >
            <div class="corner-mark"></div>
            <div class="image-wrap">
              <span class={`badge status-${item.data.status.toLowerCase().replace(/\s+/g, '-')}`}>
                {item.data.status}
              </span>
              <span class="cat-tag">{item.data.category}</span>
              <Image
                src={item.data.coverImage}
                alt={item.data.title}
                width={750}
                class="card-img"
              />
            </div>

            <div class="card-body">
              <div class="card-top">
                <h2>{item.data.title}</h2>
                {item.data.price && item.data.status !== 'Sold' && (
                  <span class="price">{item.data.price}</span>
                )}
              </div>

              {(item.data.dimensions || item.data.materials) && (
                <ul class="specs">
                  {item.data.dimensions && <li><strong>SIZE:</strong> {item.data.dimensions}</li>}
                  {item.data.materials && <li><strong>MADE OF:</strong> {item.data.materials}</li>}
                </ul>
              )}

              <div class="notes">
                <item.Content />
              </div>

              {item.data.gallery && item.data.gallery.length > 0 && (
                <details class="extra-photos">
                  <summary>+ {item.data.gallery.length} detail / before & after shot(s)</summary>
                  <div class="mini-grid">
                    {item.data.gallery.map((img) => (
                      <Image src={img} alt={item.data.title} width={400} class="mini-img" />
                    ))}
                  </div>
                </details>
              )}

              <div class="card-actions">
                {item.data.status === 'Available' && item.data.paymentLink && (
                  <a href={item.data.paymentLink} target="_blank" rel="noreferrer" class="btn btn-primary">
                    Claim / Buy Now →
                  </a>
                )}
                {(item.data.status === 'Available' || item.data.status === 'Commission Only') && (
                  <a
                    href={`mailto:${contactEmail}?subject=${mailSubject}&body=${mailBody}`}
                    class="btn btn-secondary"
                  >
                    {item.data.status === 'Commission Only' ? 'Commission Inquiry' : 'Inquire / Hold'}
                  </a>
                )}
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </main>
</BaseLayout>

<script>
  let activeRoom = 'all';
  let activeCat = 'all';
  const cards = document.querySelectorAll<HTMLElement>('.card');
  const roomBtns = document.querySelectorAll<HTMLButtonElement>('.tab');
  const catBtns = document.querySelectorAll<HTMLButtonElement>('.pill');

  function applyFilters() {
    cards.forEach((card) => {
      const matchRoom = activeRoom === 'all' || card.dataset.room === activeRoom;
      const matchCat = activeCat === 'all' || card.dataset.category === activeCat;
      card.style.display = matchRoom && matchCat ? 'inline-block' : 'none';
    });
  }

  roomBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      roomBtns.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      activeRoom = btn.dataset.room ?? 'all';
      applyFilters();
    });
  });

  catBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      catBtns.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      activeCat = btn.dataset.cat ?? 'all';
      applyFilters();
    });
  });
</script>

<style>
  .container { max-width: 1240px; margin: 0 auto; padding: 2.25rem 1.5rem; }
  .controls { display: flex; flex-direction: column; gap: 1rem; margin-bottom: 2.75rem; }
  .room-tabs, .category-pills { display: flex; flex-wrap: wrap; gap: 0.65rem; }
  .tab {
    background: var(--card-bg);
    color: var(--ink);
    border: 2px solid var(--border);
    box-shadow: 4px 4px 0 var(--border);
    padding: 0.6rem 1.15rem;
    font-family: 'Syne', sans-serif;
    font-weight: 700;
    font-size: 0.9rem;
    cursor: pointer;
    transition: transform 0.1s ease;
  }
  .tab:hover { transform: translate(-2px, -2px); }
  .tab.active { background: var(--accent); color: #121215; }
  .pill {
    background: var(--card-bg);
    color: var(--ink);
    border: 1.5px solid rgba(255, 42, 133, 0.45);
    padding: 0.35rem 0.85rem;
    font-family: 'Space Mono', monospace;
    font-size: 0.78rem;
    cursor: pointer;
  }
  .pill.active {
    background: var(--lime);
    color: #121215;
    border-color: var(--lime);
    font-weight: 700;
  }

  .masonry-wall {
    columns: 3 330px;
    column-gap: 2.25rem;
  }

  .card {
    display: inline-block;
    width: 100%;
    margin-bottom: 2.5rem;
    break-inside: avoid;
    position: relative;
    background: var(--card-bg);
    border: 2px solid var(--border);
    box-shadow: 7px 7px 0 var(--border);
    padding: 0.85rem 0.85rem 1.25rem;
    transform: rotate(var(--tilt, 0deg));
    transition: transform 0.2s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.2s ease;
  }

  .card:hover {
    transform: rotate(0deg) translate(-3px, -4px);
    box-shadow: 11px 11px 0 var(--lime);
    z-index: 2;
  }

  .corner-mark {
    position: absolute;
    top: -8px;
    right: -8px;
    width: 16px;
    height: 16px;
    background: var(--lime);
    border: 2px solid #121215;
    transform: rotate(45deg);
    z-index: 3;
  }

  .image-wrap {
    position: relative;
    overflow: hidden;
    border: 2px solid var(--border);
    background: #121215;
  }
  .card-img { width: 100%; height: auto; display: block; }
  .badge {
    position: absolute;
    top: 0.7rem;
    left: 0.7rem;
    padding: 0.24rem 0.65rem;
    font-family: 'Space Mono', monospace;
    font-size: 0.74rem;
    font-weight: 700;
    text-transform: uppercase;
    border: 2px solid #121215;
    transform: rotate(-3deg);
  }
  .status-available { background: var(--accent); color: #121215; }
  .status-sold { background: #121215; color: var(--accent); border-color: var(--accent); }
  .status-wip { background: var(--lime); color: #121215; }
  .cat-tag {
    position: absolute;
    bottom: 0.7rem;
    right: 0.7rem;
    background: #121215;
    color: var(--accent);
    border: 1.5px solid var(--accent);
    padding: 0.2rem 0.55rem;
    font-family: 'Space Mono', monospace;
    font-size: 0.72rem;
  }

  .card-body { padding: 1rem 0.25rem 0; display: flex; flex-direction: column; gap: 0.85rem; }
  .card-top { display: flex; justify-content: space-between; align-items: flex-start; gap: 0.75rem; }
  .card-top h2 { font-family: 'Syne', sans-serif; margin: 0; font-size: 1.32rem; line-height: 1.15; }
  .price {
    font-family: 'Space Mono', monospace;
    font-weight: 700;
    font-size: 1.02rem;
    background: var(--lime);
    color: #121215;
    padding: 0.15rem 0.5rem;
    border: 1.5px solid #121215;
    white-space: nowrap;
  }
  .specs {
    list-style: none;
    padding: 0.6rem 0.75rem;
    margin: 0;
    border-left: 3px solid var(--accent);
    background: rgba(255, 42, 133, 0.08);
    font-family: 'Space Mono', monospace;
    font-size: 0.76rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .notes { font-size: 0.96rem; line-height: 1.55; opacity: 0.92; }
  .notes :global(p:first-child) { margin-top: 0; }
  .extra-photos summary {
    font-family: 'Space Mono', monospace;
    font-size: 0.8rem;
    color: var(--lime);
    cursor: pointer;
    text-decoration: underline;
  }
  .mini-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.5rem; margin-top: 0.65rem; }
  .mini-img { width: 100%; height: auto; border: 1.5px solid var(--border); }
  .card-actions { padding-top: 0.35rem; display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .btn {
    display: inline-block;
    padding: 0.55rem 0.95rem;
    font-family: 'Space Mono', monospace;
    font-size: 0.8rem;
    font-weight: 700;
    text-decoration: none;
    border: 2px solid var(--border);
    cursor: pointer;
    transition: transform 0.12s ease;
  }
  .btn:hover { transform: translate(-2px, -2px); }
  .btn-primary { background: var(--accent); color: #121215; }
  .btn-secondary { background: transparent; color: var(--ink); }
</style>
