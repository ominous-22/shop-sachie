---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';

const rawPieces = await getCollection('pieces');
const activePieces = rawPieces
  .filter((p) => p.data.status !== 'Sold')
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout title="Cross-Post Workbench">
  <main class="wb-container">
    <header class="wb-header">
      <h1>Cross-Post Workbench</h1>
      <p>
        Upload a piece once in Pages CMS, then copy pre-formatted listings straight into{' '}
        <strong>eBay</strong> or <strong>Facebook Marketplace</strong> with one click.
      </p>
    </header>

    {activePieces.length === 0 ? (
      <div class="empty-box">
        <p>No active or WIP pieces on the bench yet—add one in Pages CMS and it will appear here ready to cross-post.</p>
      </div>
    ) : (
      <div class="wb-list">
        {activePieces.map((item) => {
          const d = item.data;
          const rawBody = (item.body ?? '').trim();

          const ebayTitle = [d.eraOrStyle, d.title, d.category, d.materials]
            .filter(Boolean)
            .join(' ')
            .slice(0, 80);

          const ebayBody = [
            `${d.title.toUpperCase()}`,
            d.eraOrStyle ? `Style / Era: ${d.eraOrStyle}` : null,
            d.dimensions ? `Dimensions: ${d.dimensions}` : null,
            d.materials ? `Materials / Finish: ${d.materials}` : null,
            d.conditionNotes ? `Condition & Restoration: ${d.conditionNotes}` : null,
            '',
            rawBody,
            '',
            d.pickupLocation ? `Pickup / Shipping: ${d.pickupLocation}` : 'Message for shipping quote or local pickup details.',
            'From Shop Sachie — curated & restored one-of-a-kind pieces.',
          ]
            .filter((line) => line !== null)
            .join('\n');

          const fbBody = [
            `${d.title}${d.price ? ` — ${d.price}` : ''}`,
            '',
            d.dimensions ? `📏 Dimensions: ${d.dimensions}` : null,
            d.materials ? `🪵 Materials: ${d.materials}` : null,
            d.conditionNotes ? `✨ Condition: ${d.conditionNotes}` : null,
            '',
            rawBody,
            '',
            d.pickupLocation ? `📍 ${d.pickupLocation}` : '📍 Local pickup available — message if interested!',
          ]
            .filter((line) => line !== null)
            .join('\n');

          return (
            <section class="wb-card">
              <div class="wb-visual">
                <Image src={d.coverImage} alt={d.title} width={450} height={450} class="wb-thumb" />
                <div class="wb-meta">
                  <span class="wb-status">{d.status} • {d.category}</span>
                  <h2>{d.title}</h2>
                  {d.price && <p class="wb-price">{d.price}</p>}
                  <a href={d.coverImage.src} download={`${item.id}-cover.jpg`} class="btn-download">
                    ↓ Save Optimized Cover Photo
                  </a>
                </div>
              </div>

              <div class="wb-exports">
                <div class="export-box">
                  <div class="export-head">
                    <strong>eBay Title ({ebayTitle.length}/80 chars)</strong>
                    <button type="button" class="copy-btn" data-copy={ebayTitle}>Copy Title</button>
                  </div>
                  <pre class="snippet">{ebayTitle}</pre>

                  <div class="export-head">
                    <strong>eBay Description</strong>
                    <button type="button" class="copy-btn" data-copy={ebayBody}>Copy eBay Description</button>
                  </div>
                  <pre class="snippet">{ebayBody}</pre>
                </div>

                <div class="export-box">
                  <div class="export-head">
                    <strong>Facebook Marketplace / Craigslist Post</strong>
                    <button type="button" class="copy-btn" data-copy={fbBody}>Copy Marketplace Post</button>
                  </div>
                  <pre class="snippet">{fbBody}</pre>
                </div>
              </div>
            </section>
          );
        })}
      </div>
    )}
  </main>
</BaseLayout>

<script>
  document.querySelectorAll<HTMLButtonElement>('.copy-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const text = btn.dataset.copy ?? '';
      await navigator.clipboard.writeText(text);
      const original = btn.textContent;
      btn.textContent = '✓ Copied!';
      btn.classList.add('copied');
      setTimeout(() => {
        btn.textContent = original;
        btn.classList.remove('copied');
      }, 1800);
    });
  });
</script>

<style>
  .wb-container { max-width: 1100px; margin: 0 auto; padding: 2rem 1.5rem; }
  .wb-header { margin-bottom: 2rem; }
  .wb-header h1 { margin: 0 0 0.5rem; font-size: 2.1rem; }
  .wb-list { display: flex; flex-direction: column; gap: 2.5rem; }
  .wb-card {
    background: var(--card-bg);
    border: 2px solid var(--border);
    box-shadow: 6px 6px 0 var(--border);
    padding: 1.5rem;
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 1.75rem;
  }
  @media (max-width: 820px) {
    .wb-card { grid-template-columns: 1fr; }
  }
  .wb-thumb { width: 100%; height: auto; aspect-ratio: 1 / 1; object-fit: cover; border: 2px solid var(--border); }
  .wb-meta { margin-top: 0.75rem; display: flex; flex-direction: column; gap: 0.4rem; }
  .wb-status { font-family: 'Space Mono', monospace; font-size: 0.78rem; opacity: 0.75; }
  .wb-meta h2 { margin: 0; font-size: 1.3rem; }
  .wb-price { margin: 0; font-family: 'Space Mono', monospace; font-weight: 700; color: var(--accent); }
  .btn-download {
    margin-top: 0.5rem;
    display: inline-block;
    text-align: center;
    padding: 0.5rem;
    border: 2px solid var(--border);
    font-family: 'Space Mono', monospace;
    font-size: 0.78rem;
    font-weight: 700;
    text-decoration: none;
  }
  .wb-exports { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; }
  @media (max-width: 960px) {
    .wb-exports { grid-template-columns: 1fr; }
  }
  .export-box { display: flex; flex-direction: column; gap: 0.5rem; }
  .export-head { display: flex; justify-content: space-between; align-items: center; gap: 0.5rem; font-size: 0.85rem; }
  .copy-btn {
    background: var(--accent);
    color: #fff;
    border: 2px solid var(--border);
    padding: 0.3rem 0.65rem;
    font-family: 'Space Mono', monospace;
    font-size: 0.75rem;
    font-weight: 700;
    cursor: pointer;
  }
  .copy-btn.copied { background: #181818; }
  .snippet {
    margin: 0 0 0.75rem;
    padding: 0.75rem;
    background: rgba(128, 128, 128, 0.08);
    border: 1px dashed var(--border);
    font-family: 'Space Mono', monospace;
    font-size: 0.78rem;
    white-space: pre-wrap;
    word-break: break-word;
    line-height: 1.45;
  }
  .empty-box { border: 2px dashed var(--border); padding: 2.5rem; text-align: center; }
</style>
